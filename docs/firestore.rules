rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // A user is "approved" if their users/{uid} doc says so
    // (how auth.js gates the app) OR they carry an approved custom claim.
    function isApproved() {
      return isSignedIn() && (
        request.auth.token.approved == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true)
      );
    }

    // Country Market admin = profiles/{uid}.role == 'admin'
    function cmIsAdmin() {
      return exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    // Suite-wide user-management admin — the one person who can approve
    // accounts, set responsibilities, and (via adminJobs below) create
    // accounts / set passwords. Keyed off the Auth token's own email
    // claim (set by Firebase Auth itself, not client-editable), not a
    // Firestore doc, so there's no bootstrapping chicken-and-egg problem.
    function isSuiteAdmin() {
      return isSignedIn() && request.auth.token.email.lower() == 'jayton.h@cmslivestock.com';
    }

    // Anonymous session (public Cattle Video Upload page — reps are
    // explicitly NOT approved staff; see that page's own comments).
    function isAnon() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Each person can read and create only their OWN approval record,
    // and only with approved:false — flipping it to true (or editing
    // role/allowedTabs) is the suite admin's job, via the Admin Settings
    // panel (public/shared/admin-panel.js), which only isSuiteAdmin()
    // can reach.
    match /users/{uid} {
      allow read:   if isSignedIn() && (request.auth.uid == uid || isSuiteAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.approved == false;
      allow update: if isSuiteAdmin();
      allow delete: if false;
    }

    // Admin Settings' create-account / set-password jobs — these two
    // operations need the Admin SDK (creating a Firebase Auth account or
    // setting another user's password isn't possible from the client
    // SDK without hijacking the admin's own session), so they go through
    // the same Firestore-trigger job pattern as clipTransferJobs below:
    // only the adminRunJob Cloud Function (Admin SDK, bypasses rules)
    // is ever allowed to write a result onto a job after it's created.
    match /adminJobs/{jobId} {
      allow read:   if isSuiteAdmin();
      allow create: if isSuiteAdmin()
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // Shared team data — any approved user can read and write.
    match /listingProjects/{docId} { allow read, write: if isApproved(); }
    match /stateImages/{abbr}      { allow read, write: if isApproved(); }
    match /appSettings/{key}       { allow read, write: if isApproved(); }

    // ── Video Manager ───────────────────────────────────────────
    // A public, anonymous-write submission is the one place in this
    // app where the CLIENT is not the security boundary — the upload
    // page (public/video-upload/) happens to only ever construct a
    // well-formed record via repository.js's createVideo(), but
    // that's browser JS; anyone can call the Storage/Firestore SDKs
    // directly with arbitrary data instead. This mirrors createVideo's
    // actual output shape (see repository.js) and pins every field a
    // fresh anonymous submission should never be able to fake its way
    // out of — it can't submit a record that already looks reviewed,
    // published, claimed, or used, and every free-text/URL-shaped
    // field gets a length cap so a malformed submission can't bloat
    // storage or break a staff view that assumes reasonable sizes.
    function isValidAnonVideoSubmission() {
      let d = request.resource.data;
      return d.keys().hasOnly([
        'id', 'videoId', 'baseVideoId', 'suffix', 'videoIdHistory',
        'consignorCode', 'consignorName', 'sexCode', 'sireCode', 'damCode',
        'weight', 'monthYear', 'status', 'isDraft', 'needsReview', 'videoMaker',
        'createdBy', 'dateAdded', 'lastUpdated', 'notes', 'canvaLink', 'clips',
        'listingImageUrl', 'submittedByUid', 'youtubeId', 'youtubeUrl',
        'embedUrl', 'embedCode', 'previousYouTubeVideos', 'videoFormat',
        'hasTags', 'workingOn', 'usage', 'activity'
      ])
        && d.createdBy == 'Rep'
        && d.submittedByUid == request.auth.uid
        // Must start in exactly this state — never pre-reviewed,
        // pre-published, pre-claimed, or with fabricated usage/history.
        && d.status == 'ready'
        && d.needsReview == true
        && d.workingOn == null
        && d.usage.size() == 0
        && d.videoIdHistory.size() == 0
        && d.previousYouTubeVideos.size() == 0
        && d.youtubeId == null && d.youtubeUrl == null
        && d.embedUrl == null && d.embedCode == null
        // Types + length/range caps on everything else.
        && d.id is string && d.id.size() <= 100
        && d.videoId is string && d.videoId.size() > 0 && d.videoId.size() <= 60
        && d.baseVideoId is string && d.baseVideoId.size() > 0 && d.baseVideoId.size() <= 60
        && (d.suffix == null || (d.suffix is string && d.suffix.size() <= 20))
        && d.consignorCode is string && d.consignorCode.size() <= 20
        && d.consignorName is string && d.consignorName.size() <= 200
        && d.sexCode is string && d.sexCode.size() <= 20
        && d.sireCode is string && d.sireCode.size() <= 20
        && d.damCode is string && d.damCode.size() <= 20
        && d.weight is number && d.weight > 0 && d.weight < 20000
        && d.monthYear is string && d.monthYear.size() == 4
        && d.isDraft is bool
        && d.dateAdded is string && d.lastUpdated is string
        && d.videoMaker is string && d.videoMaker.size() <= 100
        && d.notes is string && d.notes.size() <= 2000
        && (d.canvaLink == null || (d.canvaLink is string && d.canvaLink.size() <= 500))
        && (d.listingImageUrl == null || (d.listingImageUrl is string && d.listingImageUrl.size() <= 2000))
        && d.videoFormat is string && d.videoFormat.size() <= 30
        && d.hasTags is bool
        && d.clips is list && d.clips.size() <= 20
        && d.activity is list && d.activity.size() <= 5;
    }
    match /videoRecords/{id} {
      // Deliberately NOT readable by isAnon(): these documents carry
      // real business data (consignor names, internal notes, activity
      // log) — an anonymous rep session must never be able to list or
      // read this collection, only add to it. That also means the
      // public upload page can't do its own collision lookup (it would
      // need to read the collection to search it) — it always creates
      // fresh; staff already have duplicate-id detection built into the
      // Video Manager to catch and merge these after the fact.
      allow read:  if isApproved();
      allow write: if isApproved();
      // Public rep uploads (public/video-upload/, no approved staff
      // account) can only CREATE a new record, never update/delete one —
      // Firestore rules can't cheaply validate "only the clips array
      // grew, nothing else changed" the way a real update would need.
      // submittedByUid ties every public submission back to a real (if
      // anonymous) Firebase UID for traceability.
      allow create: if isAnon() && isValidAnonVideoSubmission();
    }
    // Just names/labels for the public form's dropdowns (consignor
    // names, sire/dam type labels) — no business-sensitive data, and
    // required for the public page to even render its form.
    match /referenceData/{key} {
      allow read:  if isApproved() || isAnon();
      allow write: if isApproved();
    }

    // ── Beta OBS Builder (Banners tab, "Automated Video Setup — Beta") ──
    // Reads videoRecords above for YouTube ID -> CMS Video ID lookups;
    // these three collections are its own config.
    match /obsVerificationTags/{tagId} { allow read, write: if isApproved(); }
    match /obsStingerConfig/{docId}    { allow read, write: if isApproved(); }
    match /obsBetaSettings/{docId}     { allow read, write: if isApproved(); }

    // Monday clips migration — a client write here triggers the
    // transferClip Cloud Function (see functions/index.js); only that
    // function (via the Admin SDK, which bypasses these rules) is ever
    // allowed to update a job after it's created, so a client can't
    // fake a "done" result for itself. Scoped to isSuiteAdmin() (not
    // isApproved()): this job type only ever exists to make the
    // transferClip function fetch a client-supplied publicUrl
    // server-side — see that function's SSRF hardening — so it's
    // scoped to the one account allowed to run migrations, matching
    // the requester re-check transferClip itself now does. No regular
    // staff workflow creates this job type.
    match /clipTransferJobs/{jobId} {
      allow read:   if isSuiteAdmin();
      allow create: if isSuiteAdmin()
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // ── Country Market ─────────────────────────────────────────
    // app.js's own permission model (canEditLot/canDeleteLot/
    // canChangeStatus/canViewBuyer) already draws these exact lines —
    // this just makes the rules actually enforce them, since the old
    // blanket `write: if isApproved()` let any approved suite user
    // edit/delete/change-status on ANY lot (not just their own) via a
    // direct SDK call, bypassing the app's UI-only restriction
    // entirely. Buyer-field visibility (read) and tamper-resistance
    // (write) can't be fully enforced here — Firestore rules are
    // document-granular, not field-granular, and `buyer` isn't present
    // on every lot (only once sold, so a presence-safe equality check
    // on it adds real complexity for a partial guarantee). An approved
    // rep with direct SDK access can therefore still read, or write
    // over, a lot's buyer field even though the UI hides/blocks that.
    // Closing this fully needs moving `buyer` into a separate, admin-
    // only-readable document — a real schema change, out of scope for
    // this pass (flagged in docs/HARDENING_CHECKLIST.md).
    function cmRepName() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.rep_name;
    }
    match /cmLots/{id} {
      allow read:   if isApproved();
      allow create: if isApproved();
      allow update: if isApproved() && (
        cmIsAdmin() ||
        (
          resource.data.rep == cmRepName()
          && resource.data.status in ['Staged', 'Active']
          && request.resource.data.status == resource.data.status
          && request.resource.data.rep == resource.data.rep
        )
      );
      allow delete: if isApproved() && cmIsAdmin();
    }
    match /cmActivityLog/{id} { allow read, write: if isApproved(); }
    match /cmConsignors/{id} {
      allow read:  if isApproved();
      allow write: if isApproved() && cmIsAdmin();
    }
    match /cmSettings/{id} {
      allow read:  if isApproved();
      allow write: if isApproved() && cmIsAdmin();
    }
    match /profiles/{uid} {
      // Approved users can read all profiles, and can create their own
      // on first login — but never as admin. A role escalation is a
      // trusted-process action (an existing Country Market admin, or
      // the suite admin as a bootstrap/recovery path if Country Market
      // ever has zero admins, promotes someone via the Admin page
      // afterwards) — never something a new profile can grant itself.
      // Previously this had no role restriction on create at all: any
      // approved suite user (rep, video staff, anyone) could create
      // their own profile with role:'admin' directly via the SDK,
      // bypassing the app's client-side "first user becomes admin"
      // check entirely, since that check was never enforced here.
      allow read:   if isApproved();
      allow create: if isApproved() && request.auth.uid == uid
                    && request.resource.data.role == 'rep';
      allow update: if isApproved() && (cmIsAdmin() || isSuiteAdmin());
      allow delete: if false;
    }
  }
}
