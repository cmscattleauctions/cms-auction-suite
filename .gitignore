# Local secrets for `netlify dev` — never commit real tokens/keys.
# See netlify/functions/README.md for what belongs in here.
.env
.env.local
.env.*.local
netlify/functions/.env

# Netlify CLI local state
.netlify/

# Firebase CLI debug log
firebase-debug.log

# Cloud Functions dependencies — installed locally before `firebase deploy`
functions/node_modules/

# Local script dependencies — installed locally before running
scripts/node_modules/

# OS/editor noise
.DS_Store
