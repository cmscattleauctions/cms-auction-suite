rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }

    // Mirrors isApproved() in docs/firestore.rules — Storage Rules can
    // read Firestore directly via the firestore.* functions, so approval
    // stays defined in exactly one place (the users/{uid} doc) instead of
    // needing a second, separately-maintained copy of who's approved.
    function isApproved() {
      return isSignedIn() && (
        request.auth.token.approved == true ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.approved == true)
      );
    }

    // Anonymous session (public Cattle Video Upload page — reps are
    // explicitly NOT approved staff; see that page's own comments).
    function isAnon() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Video Manager clip files — videoClips/{recordId}/{fileName}.
    // Hard caps enforced here, not just in the upload UI, so a bug or a
    // bypassed client can't accidentally write something huge: 2GB max
    // per file, must actually be a video. This is the real backstop
    // behind the app's own pre-flight size checks.
    match /videoClips/{recordId}/{fileName} {
      // isAnon() also needs read: storage-data.js's uploadClip() (used
      // by BOTH the staff upload flow and the public rep page) calls
      // getDownloadURL() right after the upload finishes to hand back
      // a usable link — without read access here, that call was
      // rejected for every anonymous uploader, which made the whole
      // upload look like it had failed (it hadn't — the bytes were
      // already safely in Storage, just impossible to get a URL back
      // for). No new confidentiality boundary is given up by this: an
      // anonymous session can already CREATE (fully control the
      // content of) any path under here, and every one of these clips
      // is destined to become a published, public marketing video once
      // staff reviews it — there was never a real secret here for
      // isApproved()-only read to be protecting.
      allow read: if isApproved() || isAnon();
      allow write: if isApproved()
                   && request.resource.size < 2 * 1024 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
      // Public rep uploads (public/video-upload/) — no approved staff
      // account. `recordId` here is a throwaway per-file grouping id
      // picked client-side before the real videoRecords document even
      // exists (uploads start immediately on file pick, same as the
      // staff upload flow — see storage-data.js's own comment on why),
      // so it can't be cross-checked against a Firestore doc the way
      // isApproved() checks users/{uid}. Content-type + size are the
      // actual boundary here, same caps as staff get.
      allow create: if isAnon()
                    && request.resource.size < 2 * 1024 * 1024 * 1024
                    && request.resource.contentType.matches('video/.*');
    }

    // Public rep-upload listing photo — was previously read as a local
    // base64 data URL and stored inline on the videoRecords document
    // (often several MB of text); now uploaded here like a clip, with
    // just the resulting download URL stored on the record instead
    // (see storage-data.js's uploadListingImage() and its own comment
    // for why, and docs/firestore.rules' listingImageUrl length cap,
    // sized for a real URL rather than inline image data).
    match /listingImages/{recordId}/{fileName} {
      allow read: if isApproved() || isAnon();
      allow write: if isApproved()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow create: if isAnon()
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    // Beta OBS Builder — verification tag images (small, PNG/SVG).
    match /obs-verification-tags/{tagId}/{fileName} {
      allow read: if isApproved();
      allow write: if isApproved()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|svg\\+xml)');
    }

    // Beta OBS Builder — the CMS Stinger video asset (must be a video —
    // see beta-stinger-data.js for why a static image isn't supported).
    // webm is included alongside mp4/quicktime because OBS stinger clips
    // with alpha-channel transparency are conventionally exported as
    // VP9 webm (mp4/mov can't carry a browser-uploadable alpha track).
    match /obs-stinger/{fileName} {
      allow read: if isApproved();
      allow write: if isApproved()
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('video/(mp4|quicktime|webm)');
    }
  }
}
